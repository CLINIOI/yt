/* light.qss — Светлая тема YT Manager
 * Палитра: фон #f6f5f2, акцент #2c6d77, текст #1c1b19.
 */

QMainWindow, QWidget#central { background: #f6f5f2; color: #1c1b19; }
QWidget { color: #1c1b19; }

QFrame#sidebar { background: #ecebe7; border-right: 1px solid #d8d6d1; }

QLabel#app_logo {
    color: #2c6d77; font-size: 20px; font-weight: 700;
    letter-spacing: 1px; padding: 0 20px;
}
QLabel#app_sub  { color: #8a8985; padding: 0 20px; font-size: 10px; }

QFrame#sidebar_div {
    background: #d8d6d1; border: none;
    max-height: 1px; margin: 4px 16px;
}

QLabel#nav_section {
    color: #8a8985; font-size: 10px;
    letter-spacing: 1.5px; padding: 0 20px;
}

QPushButton#nav_btn {
    background: transparent; border: none; border-radius: 8px;
    color: #4a4845; font-size: 13px;
    text-align: left; padding: 10px 16px;
    margin: 1px 8px;
}
QPushButton#nav_btn:hover   { background: #e0ded9; color: #1c1b19; }
QPushButton#nav_btn:checked { background: #d2e6e9; color: #2c6d77; font-weight: 600; }

QPushButton#nav_btn_tw {
    background: transparent; border: none; border-radius: 8px;
    color: #4a4845; font-size: 13px;
    text-align: left; padding: 10px 16px;
    margin: 1px 8px;
}
QPushButton#nav_btn_tw:hover   { background: #e0ded9; color: #1c1b19; }
QPushButton#nav_btn_tw:checked {
    background: #d2e6e9; color: #2c6d77; font-weight: 600;
    border-left: 3px solid #2c6d77;
}

QFrame#sidebar_status { background: #f6f5f2; border-top: 1px solid #d8d6d1; }
QLabel#status_tool    { color: #8a8985; font-size: 11px; }
QLabel#status_tool[ok="true"]  { color: #437a22; }
QLabel#status_tool[ok="false"] { color: #964219; }

QLabel#dl_counter { color: #8a8985; font-size: 11px; padding: 0 20px; }
QLabel#dl_counter[active="true"] { color: #2c6d77; }
QLabel#version_label { color: #b8b6b1; font-size: 10px; padding: 0 20px; }

QStatusBar { background: #ecebe7; color: #4a4845; font-size: 11px;
             border-top: 1px solid #d8d6d1; }
QStatusBar::item { border: none; }

/* ── ОБЩИЕ ВИДЖЕТЫ ── */
QGroupBox {
    background: #ffffff; border: 1px solid #d8d6d1; border-radius: 8px;
    margin-top: 14px; padding: 10px; color: #1c1b19;
}
QGroupBox::title {
    subcontrol-origin: margin; left: 12px; padding: 0 4px;
    color: #2c6d77; font-weight: 600;
}

QPushButton {
    background: #ecebe7; color: #1c1b19; border: 1px solid #d8d6d1;
    border-radius: 6px; padding: 6px 14px; min-height: 22px;
}
QPushButton:hover    { background: #e0ded9; border-color: #2c6d77; }
QPushButton:pressed  { background: #d2e6e9; }
QPushButton:disabled { color: #b8b6b1; background: #f3f2ee; }

QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background: #ffffff; color: #1c1b19; border: 1px solid #d8d6d1;
    border-radius: 5px; padding: 4px 6px; selection-background-color: #2c6d77;
    selection-color: #ffffff;
}
QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 1px solid #2c6d77;
}

QComboBox::drop-down { border: none; width: 18px; }
QComboBox QAbstractItemView {
    background: #ffffff; color: #1c1b19; border: 1px solid #d8d6d1;
    selection-background-color: #d2e6e9; selection-color: #2c6d77;
}

QListWidget, QTableWidget, QTreeWidget, QTreeView {
    background: #ffffff; color: #1c1b19; border: 1px solid #d8d6d1;
    alternate-background-color: #f3f2ee; gridline-color: #d8d6d1;
}
QListWidget::item:selected, QTableWidget::item:selected,
QTreeWidget::item:selected, QTreeView::item:selected {
    background: #d2e6e9; color: #2c6d77;
}
QHeaderView::section {
    background: #ecebe7; color: #1c1b19; padding: 6px;
    border: 0; border-right: 1px solid #d8d6d1;
}

QTabWidget::pane { border: 1px solid #d8d6d1; background: #ffffff; }
QTabBar::tab {
    background: #ecebe7; color: #4a4845; padding: 8px 14px;
    border: 1px solid #d8d6d1; border-bottom: none;
}
QTabBar::tab:selected { background: #d2e6e9; color: #2c6d77; }
QTabBar::tab:hover    { color: #1c1b19; }

QMenu {
    background: #ffffff; color: #1c1b19; border: 1px solid #d8d6d1;
}
QMenu::item:selected { background: #d2e6e9; color: #2c6d77; }

QScrollBar:vertical, QScrollBar:horizontal {
    background: #f6f5f2; border: none; width: 10px; height: 10px;
}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #d8d6d1; border-radius: 5px; min-height: 30px; min-width: 30px;
}
QScrollBar::handle:hover { background: #2c6d77; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }

QProgressBar {
    background: #ffffff; border: 1px solid #d8d6d1; border-radius: 4px;
    color: #1c1b19; text-align: center; min-height: 16px;
}
QProgressBar::chunk { background: #2c6d77; border-radius: 3px; }

QCheckBox, QRadioButton { color: #1c1b19; spacing: 6px; }
QCheckBox::indicator, QRadioButton::indicator {
    width: 14px; height: 14px; border: 1px solid #b8b6b1;
    background: #ffffff;
}
QCheckBox::indicator { border-radius: 3px; }
QRadioButton::indicator { border-radius: 7px; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: #2c6d77; border-color: #2c6d77;
}

QMessageBox { background: #ffffff; color: #1c1b19; }
QToolTip { background: #ffffff; color: #1c1b19; border: 1px solid #d8d6d1;
           padding: 4px; }

QFrame#theme_card {
    background: #ffffff; border: 1px solid #d8d6d1; border-radius: 8px;
}
QFrame#theme_card[selected="true"] {
    border: 2px solid #2c6d77; background: #f1f9fa;
}

QFrame#auto_master {
    background: #ffffff; border: 1px solid #d8d6d1; border-radius: 8px;
}

/* ===== yt_manager: uniform page styles (do not remove) ===== */

/* Заголовки страниц */
QWidget#page_header {
    background: #ecebe7;
    border-bottom: 1px solid #d8d6d1;
}
QLabel#page_heading {
    color: #1c1b19;
    font-size: 20px;
    font-weight: 700;
}
QLabel#page_subtitle {
    color: #555350;
    font-size: 12px;
}

/* Settings — общая область с прокруткой */
QScrollArea#settings_scroll {
    background: transparent;
    border: none;
}
QWidget#settings_content {
    background: transparent;
}

/* Подсказки и второстепенный текст */
QLabel#settings_hint, QLabel#auto_hint, QLabel#theme_card_hint {
    color: #797876;
    font-size: 11px;
}
QLabel#settings_accent {
    color: #2c6d77;
    font-size: 11px;
    font-weight: 600;
}

/* Метки состояний (settings_status + общие info/ok/err/off) */
QLabel#settings_status { color: #797876; font-size: 12px; }
QLabel#settings_status[state="info"]    { color: #2c6d77; font-weight: 600; }
QLabel#settings_status[state="ok"]      { color: #2e7d32; font-weight: 700; }
QLabel#settings_status[state="err"]     { color: #c62828; font-weight: 700; }
QLabel#settings_status[state="off"]     { color: #797876; }

/* Заголовки диалогов (результат проверки куки и т.п.) */
QLabel#dlg_title_ok  { color: #2e7d32; font-weight: 700; font-size: 14px; }
QLabel#dlg_title_err { color: #c62828; font-weight: 700; font-size: 14px; }

/* Кнопки акцента (btn_primary) — используются на Настройках */
QPushButton#btn_primary {
    background: #2c6d77;
    color: #ffffff;
    border: 1px solid #2c6d77;
    border-radius: 6px;
    padding: 6px 14px;
    font-weight: 600;
}
QPushButton#btn_primary:hover  { background: #d8d6d1; color: #1c1b19; border-color: #2c6d77; }
QPushButton#btn_primary:pressed{ background: #ecebe7; color: #1c1b19; }
QPushButton#btn_primary:disabled {
    background: #ecebe7; color: #555350; border-color: #d8d6d1;
}

/* Автоматизация — большая кнопка переключения (state=on/off) */
QPushButton#auto_toggle {
    background: #ecebe7;
    color: #1c1b19;
    border: 1px solid #d8d6d1;
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 13px;
    font-weight: 700;
}
QPushButton#auto_toggle:hover { background: #d8d6d1; }
QPushButton#auto_toggle[state="on"] {
    background: #c62828; color: #ffffff; border-color: #c62828;
}
QPushButton#auto_toggle[state="on"]:hover {
    background: #c62828;
}
QPushButton#auto_toggle[state="off"] {
    background: #2e7d32; color: #ffffff; border-color: #2e7d32;
}
QPushButton#auto_toggle[state="off"]:hover {
    background: #2e7d32;
}

/* Автоматизация — индикатор состояния */
QLabel#auto_state {
    font-size: 14px; font-weight: 600; color: #555350;
}
QLabel#auto_state[state="off"]     { color: #c62828; }
QLabel#auto_state[state="waiting"] { color: #2e7d32; }
QLabel#auto_state[state="running"] { color: #2c6d77; }

