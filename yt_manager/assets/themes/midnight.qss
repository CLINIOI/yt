/* midnight.qss — Midnight тема YT Manager
 * Глубокий чёрно-синий: фон #0d1220, акцент #4d7fff, текст #e0e6f0.
 */

QMainWindow, QWidget#central { background: #0d1220; color: #e0e6f0; }
QWidget { color: #e0e6f0; }

QFrame#sidebar { background: #131a2c; border-right: 1px solid #1f2a44; }

QLabel#app_logo {
    color: #4d7fff; font-size: 20px; font-weight: 700;
    letter-spacing: 1px; padding: 0 20px;
}
QLabel#app_sub  { color: #6c7693; font-size: 10px; padding: 0 20px; }

QFrame#sidebar_div {
    background: #1f2a44; border: none;
    max-height: 1px; margin: 4px 16px;
}

QLabel#nav_section {
    color: #6c7693; font-size: 10px;
    letter-spacing: 1.5px; padding: 0 20px;
}

QPushButton#nav_btn {
    background: transparent; border: none; border-radius: 8px;
    color: #8a93b0; font-size: 13px;
    text-align: left; padding: 10px 16px;
    margin: 1px 8px;
}
QPushButton#nav_btn:hover   { background: #1a233c; color: #e0e6f0; }
QPushButton#nav_btn:checked { background: #1f2c4f; color: #4d7fff; font-weight: 600; }

QPushButton#nav_btn_tw {
    background: transparent; border: none; border-radius: 8px;
    color: #8a93b0; font-size: 13px;
    text-align: left; padding: 10px 16px;
    margin: 1px 8px;
}
QPushButton#nav_btn_tw:hover   { background: #1a233c; color: #e0e6f0; }
QPushButton#nav_btn_tw:checked {
    background: #1f2c4f; color: #4d7fff; font-weight: 600;
    border-left: 3px solid #4d7fff;
}

QFrame#sidebar_status { background: #0d1220; border-top: 1px solid #1f2a44; }
QLabel#status_tool    { color: #4a5470; font-size: 11px; }
QLabel#status_tool[ok="true"]  { color: #46c97a; }
QLabel#status_tool[ok="false"] { color: #ff6b6b; }

QLabel#dl_counter { color: #6c7693; font-size: 11px; padding: 0 20px; }
QLabel#dl_counter[active="true"] { color: #4d7fff; }
QLabel#version_label { color: #4a5470; font-size: 10px; padding: 0 20px; }

QStatusBar { background: #131a2c; color: #6c7693; font-size: 11px;
             border-top: 1px solid #1f2a44; }
QStatusBar::item { border: none; }

QGroupBox {
    background: #131a2c; border: 1px solid #1f2a44; border-radius: 8px;
    margin-top: 14px; padding: 10px; color: #e0e6f0;
}
QGroupBox::title {
    subcontrol-origin: margin; left: 12px; padding: 0 4px;
    color: #4d7fff; font-weight: 600;
}

QPushButton {
    background: #1a233c; color: #e0e6f0; border: 1px solid #1f2a44;
    border-radius: 6px; padding: 6px 14px; min-height: 22px;
}
QPushButton:hover    { background: #1f2c4f; border-color: #4d7fff; }
QPushButton:pressed  { background: #131a2c; }
QPushButton:disabled { color: #4a5470; background: #131a2c; }

QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background: #181f35; color: #e0e6f0; border: 1px solid #1f2a44;
    border-radius: 5px; padding: 4px 6px; selection-background-color: #4d7fff;
    selection-color: #ffffff;
}
QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 1px solid #4d7fff;
}

QComboBox::drop-down { border: none; width: 18px; }
QComboBox QAbstractItemView {
    background: #131a2c; color: #e0e6f0; border: 1px solid #1f2a44;
    selection-background-color: #1f2c4f; selection-color: #4d7fff;
}

QListWidget, QTableWidget, QTreeWidget, QTreeView {
    background: #131a2c; color: #e0e6f0; border: 1px solid #1f2a44;
    alternate-background-color: #181f35; gridline-color: #1f2a44;
}
QListWidget::item:selected, QTableWidget::item:selected,
QTreeWidget::item:selected, QTreeView::item:selected {
    background: #1f2c4f; color: #4d7fff;
}
QHeaderView::section {
    background: #1a233c; color: #e0e6f0; padding: 6px;
    border: 0; border-right: 1px solid #1f2a44;
}

QTabWidget::pane { border: 1px solid #1f2a44; background: #131a2c; }
QTabBar::tab {
    background: #131a2c; color: #8a93b0; padding: 8px 14px;
    border: 1px solid #1f2a44; border-bottom: none;
}
QTabBar::tab:selected { background: #1f2c4f; color: #4d7fff; }
QTabBar::tab:hover    { color: #e0e6f0; }

QMenu {
    background: #131a2c; color: #e0e6f0; border: 1px solid #1f2a44;
}
QMenu::item:selected { background: #1f2c4f; color: #4d7fff; }

QScrollBar:vertical, QScrollBar:horizontal {
    background: #0d1220; border: none; width: 10px; height: 10px;
}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #1f2a44; border-radius: 5px; min-height: 30px; min-width: 30px;
}
QScrollBar::handle:hover { background: #4d7fff; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }

QProgressBar {
    background: #181f35; border: 1px solid #1f2a44; border-radius: 4px;
    color: #e0e6f0; text-align: center; min-height: 16px;
}
QProgressBar::chunk { background: #4d7fff; border-radius: 3px; }

QCheckBox, QRadioButton { color: #e0e6f0; spacing: 6px; }
QCheckBox::indicator, QRadioButton::indicator {
    width: 14px; height: 14px; border: 1px solid #6c7693;
    background: #181f35;
}
QCheckBox::indicator { border-radius: 3px; }
QRadioButton::indicator { border-radius: 7px; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: #4d7fff; border-color: #4d7fff;
}

QMessageBox { background: #131a2c; color: #e0e6f0; }
QToolTip { background: #181f35; color: #e0e6f0; border: 1px solid #1f2a44;
           padding: 4px; }

QFrame#theme_card {
    background: #131a2c; border: 1px solid #1f2a44; border-radius: 8px;
}
QFrame#theme_card[selected="true"] {
    border: 2px solid #4d7fff; background: #1a233c;
}

QFrame#auto_master {
    background: #131a2c; border: 1px solid #1f2a44; border-radius: 8px;
}

/* ===== yt_manager: uniform page styles (do not remove) ===== */

/* Заголовки страниц */
QWidget#page_header {
    background: #131a2c;
    border-bottom: 1px solid #1f2a44;
}
QLabel#page_heading {
    color: #e0e6f0;
    font-size: 20px;
    font-weight: 700;
}
QLabel#page_subtitle {
    color: #9aa3c0;
    font-size: 12px;
}

/* Settings — общая область с прокруткой */
QScrollArea#settings_scroll {
    background: transparent;
    border: none;
}
QWidget#settings_content {
    background: transparent;
}

/* Подсказки и второстепенный текст */
QLabel#settings_hint, QLabel#auto_hint, QLabel#theme_card_hint {
    color: #6c7693;
    font-size: 11px;
}
QLabel#settings_accent {
    color: #4d7fff;
    font-size: 11px;
    font-weight: 600;
}

/* Метки состояний (settings_status + общие info/ok/err/off) */
QLabel#settings_status { color: #6c7693; font-size: 12px; }
QLabel#settings_status[state="info"]    { color: #4d7fff; font-weight: 600; }
QLabel#settings_status[state="ok"]      { color: #4caf50; font-weight: 700; }
QLabel#settings_status[state="err"]     { color: #ef5350; font-weight: 700; }
QLabel#settings_status[state="off"]     { color: #6c7693; }

/* Заголовки диалогов (результат проверки куки и т.п.) */
QLabel#dlg_title_ok  { color: #4caf50; font-weight: 700; font-size: 14px; }
QLabel#dlg_title_err { color: #ef5350; font-weight: 700; font-size: 14px; }

/* Кнопки акцента (btn_primary) — используются на Настройках */
QPushButton#btn_primary {
    background: #4d7fff;
    color: #0d1220;
    border: 1px solid #4d7fff;
    border-radius: 6px;
    padding: 6px 14px;
    font-weight: 600;
}
QPushButton#btn_primary:hover  { background: #243058; color: #e0e6f0; border-color: #4d7fff; }
QPushButton#btn_primary:pressed{ background: #1a2236; color: #e0e6f0; }
QPushButton#btn_primary:disabled {
    background: #1a2236; color: #9aa3c0; border-color: #1f2a44;
}

/* Автоматизация — большая кнопка переключения (state=on/off) */
QPushButton#auto_toggle {
    background: #1a2236;
    color: #e0e6f0;
    border: 1px solid #1f2a44;
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 13px;
    font-weight: 700;
}
QPushButton#auto_toggle:hover { background: #243058; }
QPushButton#auto_toggle[state="on"] {
    background: #ef5350; color: #ffffff; border-color: #ef5350;
}
QPushButton#auto_toggle[state="on"]:hover {
    background: #ff8a80;
}
QPushButton#auto_toggle[state="off"] {
    background: #4caf50; color: #ffffff; border-color: #4caf50;
}
QPushButton#auto_toggle[state="off"]:hover {
    background: #4caf50;
}

/* Автоматизация — индикатор состояния */
QLabel#auto_state {
    font-size: 14px; font-weight: 600; color: #9aa3c0;
}
QLabel#auto_state[state="off"]     { color: #ef5350; }
QLabel#auto_state[state="waiting"] { color: #4caf50; }
QLabel#auto_state[state="running"] { color: #4d7fff; }

